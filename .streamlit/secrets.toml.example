[app]
destino = "local" # Troque para "online" na hospedagem do dashboard.
dados_ficticios = true # Troque para false quando importar os dados oficiais.

[acesso]
senha_lancamento = "DEFINA_UMA_SENHA"

[mysql]
host = "127.0.0.1"
port = 3306
user = "root"
password = "SUA_SENHA_LOCAL"
database = "dashboard_saga"
criar_banco = true

# Descomente o bloco inteiro depois de criar o servico e o banco no Aiven.
